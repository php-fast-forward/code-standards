* text=auto
*.php text eol=lf
/bin/code-standards text eol=lf
/builds/code-standards binary

# Local state and synchronized copies never belong to package distributions.
/.git export-ignore
/vendor/ export-ignore
/.agents/ export-ignore
/.build/ export-ignore
/.phpunit.cache/ export-ignore
/packaging-consumer/ export-ignore

# Contributor-only configuration and test infrastructure.
/tests/ export-ignore
/scripts/phar/ export-ignore
/.github/workflows/ export-ignore
/AGENTS.md export-ignore
/skills.json export-ignore
/phpunit.xml export-ignore
/.editorconfig export-ignore
/.gitignore export-ignore
/.gitattributes export-ignore
/.changelog/ export-ignore

# Ready distributions retain the PHAR, manifests, complete resources and documentation.
/src/ export-ignore
/config/ export-ignore
/bin/ export-ignore
