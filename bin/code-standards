#!/usr/bin/env php
<?php

declare(strict_types=1);

use FastForward\CodeStandards\Console\Application;
use FastForward\CodeStandards\ServiceProvider\StandardsServiceProvider;
use FastForward\Container\ContainerFactory;
use Symfony\Component\Console\Output\ConsoleOutput;

$autoloadCandidates = [
    ...(isset($_composer_autoload_path) && is_string($_composer_autoload_path) ? [$_composer_autoload_path] : []),
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

foreach ($autoloadCandidates as $autoload) {
    if (is_file($autoload)) {
        require $autoload;

        $output = new ConsoleOutput();
        $container = ContainerFactory::create(new StandardsServiceProvider(dirname($autoload), $output));

        exit($container->get(Application::class)->run(output: $output));
    }
}

fwrite(STDERR, "Could not locate Composer autoload.php for fast-forward/code-standards.\n");

exit(1);
