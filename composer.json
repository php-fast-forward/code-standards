{
    "name": "fast-forward/code-standards",
    "description": "Focused PHP style presets, syntax checks and changed-file automation.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "code-standards",
        "code-style",
        "ecs",
        "fast-forward",
        "php",
        "symfony-console"
    ],
    "readme": "README.md",
    "authors": [
        {
            "name": "Felipe Sayão Lobato Abreu",
            "email": "github@mentordosnerds.com",
            "homepage": "https://github.com/coisa",
            "role": "Maintainer"
        }
    ],
    "homepage": "https://github.com/php-fast-forward/code-standards",
    "support": {
        "issues": "https://github.com/php-fast-forward/code-standards/issues",
        "source": "https://github.com/php-fast-forward/code-standards",
        "docs": "https://github.com/php-fast-forward/code-standards#readme"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/php-fast-forward"
        },
        {
            "type": "custom",
            "url": "https://www.paypal.com/donate/?business=JLDAF45XZ8D84"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-filter": "*",
        "ext-hash": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-pcre": "*",
        "ext-phar": "*",
        "ext-reflection": "*",
        "ext-tokenizer": "*",
        "ext-zlib": "*"
    },
    "require-dev": {
        "composer-runtime-api": "^2.2",
        "composer/composer": "^2.10.3",
        "container-interop/service-provider": "^0.4.1",
        "ergebnis/json": "^1.7.0",
        "ergebnis/json-normalizer": "^4.11.0",
        "ergebnis/json-printer": "^3.9.1",
        "fast-forward/container": "^1.10.1",
        "llm/skills": "^1.15",
        "phpstan/phpstan": "^2.3.3",
        "phpunit/phpunit": "^12.5",
        "povils/phpmnd": "^3.6.1",
        "psr/container": "^1.1 || ^2.0",
        "rector/rector": "^2.8.2",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/filesystem": "^7.4 || ^8.0",
        "symfony/process": "^7.4 || ^8.0",
        "symplify/easy-coding-standard": "^13.3.8"
    },
    "suggest": {
        "ext-dom": "Generate native XML reports for optional magic-number analysis.",
        "llm/skills": "Optionally synchronize the bundled agent skill in consumer projects."
    },
    "minimum-stability": "stable",
    "autoload-dev": {
        "psr-4": {
            "FastForward\\CodeStandards\\": "src/",
            "FastForward\\CodeStandards\\Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "/tests/Fixtures/"
        ]
    },
    "bin": [
        "builds/code-standards"
    ],
    "config": {
        "allow-plugins": {
            "llm/skills": true
        },
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "extra": {
        "skills": {
            "source": "resources/skills"
        },
        "phar": {
            "runtime-packages": [
                "composer/composer",
                "container-interop/service-provider",
                "ergebnis/json",
                "ergebnis/json-normalizer",
                "ergebnis/json-printer",
                "fast-forward/container",
                "phpstan/phpstan",
                "povils/phpmnd",
                "psr/container",
                "rector/rector",
                "symfony/console",
                "symfony/process",
                "symplify/easy-coding-standard"
            ]
        }
    },
    "scripts": {
        "check": [
            "@composer validate --strict",
            "@composer check-platform-reqs",
            "@test",
            "@php bin/code-standards check --all"
        ],
        "fix": "@php bin/code-standards fix --all",
        "test": "phpunit",
        "build": "@php -d phar.readonly=0 scripts/phar/build.php"
    }
}
